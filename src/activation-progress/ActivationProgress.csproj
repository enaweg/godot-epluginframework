<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Framework-dependent and RID-neutral: one small assembly for every platform, started with the
    `dotnet` host the framework already requires. Each OS draws its window with native APIs instead of a
    bundled UI toolkit, which keeps the published helper at a few dozen kilobytes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Embedded as resource 1; Win32ProgressWindow activates it to get the themed marquee progress bar. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../design/icon-nobg_small.png" LogicalName="ActivationProgress.Logo.png" />
  </ItemGroup>
</Project>

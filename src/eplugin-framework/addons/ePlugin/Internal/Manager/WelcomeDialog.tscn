[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/ePlugin/Internal/Manager/WelcomeDialog.cs" id="1_script"]

[node name="WelcomeDialog" type="AcceptDialog"]
auto_translate_mode = 2
title = "ePlugin — Welcome"
initial_position = 2
size = Vector2i(900, 560)
min_size = Vector2i(600, 360)
ok_button_text = "Close"
script = ExtResource("1_script")

[node name="Content" type="VBoxContainer" parent="."]
offset_left = 8.0
offset_top = 8.0
offset_right = 892.0
offset_bottom = 511.0
theme_override_constants/separation = 8

[node name="Summary" type="Label" parent="Content"]

[node name="CheckEnabledCheck" type="CheckBox" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Checks for updates once per editor session, when the last successful check is old enough. Check for updates in the ePlugin Manager always works.
eplugin/updates/check_enabled"
text = "Check for updates when the editor starts"
metadata/setting = "eplugin/updates/check_enabled"

[node name="CheckIntervalLabel" type="Label" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
text = "Hours between checks"

[node name="CheckIntervalSpin" type="SpinBox" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "The minimum time between successful scheduled checks.
eplugin/updates/check_interval_hours"
min_value = 1.0
max_value = 8760.0
value = 20.0
rounded = true
suffix = "h"
metadata/setting = "eplugin/updates/check_interval_hours"

[node name="BuildFailureLabel" type="Label" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
text = "When an update does not build"

[node name="BuildFailureOption" type="OptionButton" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "Ask: asks for an update started from a plugin's details and rolls back otherwise. Self-updates, headless runs and batches of several groups always roll back.
eplugin/updates/on_build_failure"
selected = 0
item_count = 3
popup/item_0/text = "Ask"
popup/item_0/id = 0
popup/item_1/text = "Roll back"
popup/item_1/id = 1
popup/item_2/text = "Keep the new version"
popup/item_2/id = 2
metadata/setting = "eplugin/updates/on_build_failure"
metadata/values = PackedStringArray("ask", "rollback", "keep")

[node name="ProjectErrorsLabel" type="Label" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
text = "Errors only in the project's code"

[node name="ProjectErrorsCheck" type="CheckBox" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Keeps an update whose build fails only in the project's own code while its plugins compile on their own, unless updates that do not build are rolled back.
eplugin/updates/keep_on_project_errors"
text = "Keep the update when its plugins compile on their own"
metadata/setting = "eplugin/updates/keep_on_project_errors"

[node name="RestartLabel" type="Label" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]
layout_mode = 2

eplugin/updates/restart_policy"
selected = 0
item_count = 2
popup/item_0/text = "When needed"
popup/item_0/id = 0
popup/item_1/text = "After every update"
popup/item_1/id = 1
metadata/setting = "eplugin/updates/restart_policy"
metadata/values = PackedStringArray("auto", "always")

[node name="BuiltinSitesLabel" type="Label" parent="SettingsTabs/General/GeneralScroll/GeneralBox/UpdatesGrid"]

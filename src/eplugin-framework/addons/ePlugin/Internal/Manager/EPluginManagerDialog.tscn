[node name="InstallZipButton" type="Button" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Install from ZIP
Install a plugin from a ZIP file, such as one downloaded from the Godot Asset Library. A ZIP file of a plugin that is installed already installs its version over it, like an update."

<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>EPluginFramework</RootNamespace>
    <AssemblyName>EPluginFramework</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!--
    The progress window helper is gitignored and only published by CI for release archives. Publish it here too,
    so a development checkout shows the window after a normal build. Same command as CI; runs again only when the
    helper's sources change. Best-effort: ActivationProgress runs without a window when the helper is missing.
  -->
  <PropertyGroup>
    <ActivationProgressProjectDir>$(MSBuildProjectDirectory)/../activation-progress</ActivationProgressProjectDir>
    <ActivationProgressPublishDir>$(MSBuildProjectDirectory)/addons/ePlugin/progress</ActivationProgressPublishDir>
  </PropertyGroup>
  <ItemGroup>
    <ActivationProgressSources Include="$(ActivationProgressProjectDir)/*.cs;$(ActivationProgressProjectDir)/*.csproj;$(ActivationProgressProjectDir)/app.manifest;$(MSBuildProjectDirectory)/../../design/icon-nobg_small.png" />
  </ItemGroup>
  <Target Name="PublishActivationProgress" BeforeTargets="Build"
          Condition="Exists('$(ActivationProgressProjectDir)/ActivationProgress.csproj')"
          Inputs="@(ActivationProgressSources)" Outputs="$(ActivationProgressPublishDir)/ActivationProgress.dll">
    <Exec Command="dotnet publish &quot;$(ActivationProgressProjectDir)/ActivationProgress.csproj&quot; --configuration Release -p:DebugType=None --output &quot;$(ActivationProgressPublishDir)&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>

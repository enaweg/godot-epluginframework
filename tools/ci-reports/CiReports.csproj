<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The CI workflows' reports: line coverage summaries and the coverage branch (coverage summary|history), and the
    static-analysis summary (analysis). Run with dotnet run, passing the command after the project and a double dash.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CiReports.Tests" />
  </ItemGroup>
</Project>
